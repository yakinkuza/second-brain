# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key   # server-side only!

# ---- Embedding (local ผ่าน Ollama — ไม่เสีย API token) ----
# ติดตั้ง https://ollama.com แล้วรัน: ollama pull bge-m3
OLLAMA_URL=http://localhost:11434

# ---- LLM ----
# ใช้ Claude Code CLI ในเครื่อง (ไม่ต้องใส่ ANTHROPIC_API_KEY)
# ติดตั้ง: npm install -g @anthropic-ai/claude-code
# แล้วรัน `claude` ครั้งนึงเพื่อล็อกอินด้วย Claude subscription (Pro/Max)

# ---- persona ----
SECOND_BRAIN_AUTHOR=ชื่อเจ้าของ second brain
